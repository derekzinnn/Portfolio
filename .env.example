# Playwright preview capture (scripts/capture-previews.ts).
# Copy to .env.local and fill in. NEVER commit .env.local (it holds real creds).

# --- Nic Crochet (public storefront, no login) ---
PREVIEW_NIC_URL=https://nic.derek.dev.br

# --- Inova Stok (login-gated) ---
# The script logs in with these before capturing the real inventory UI.
PREVIEW_INOVA_URL=https://inova.derek.dev.br
PREVIEW_INOVA_LOGIN_URL=https://inova.derek.dev.br/login
PREVIEW_INOVA_USER=
PREVIEW_INOVA_PASS=

# Optional — override only if the login form differs from the defaults:
# PREVIEW_INOVA_USER_SEL=input[name="email"]
# PREVIEW_INOVA_PASS_SEL=input[type="password"]
# PREVIEW_INOVA_SUBMIT_SEL=button[type="submit"]
# PREVIEW_INOVA_READY_SEL=[data-testid="inventory"]   # a selector unique to the logged-in page
